{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": "backend",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    }
  ]
}
