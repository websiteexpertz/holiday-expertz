{
  "name": "holiday-expertz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:backend": "npm run build --workspace holiday-expertz-backend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "seed:db": "npx tsx backend/src/scripts/seedLocalMongo.ts",
    "test:db": "npx tsx backend/src/scripts/testConnection.ts",
    "test:api": "npx tsx backend/src/scripts/testAllApiEndpoints.ts",
    "test:unit": "npx tsx backend/src/tests/unit.test.ts",
    "test:integration": "npx tsx backend/src/tests/integration.test.ts",
    "test": "npx tsx backend/src/tests/runAllTests.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "mongoose": "^9.11.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
