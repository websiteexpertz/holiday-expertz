# HolidayExpertz Environment Configuration Template
# Copy this file to .env.local to customize your local development environment

# Server Runtime Environment
NODE_ENV=development
PORT=3000

# Required API service configuration
MONGODB_URI=mongodb://localhost:27017/holidayexpertz
ADMIN_SESSION_SECRET=replace-with-a-long-random-production-secret

# Backend Storage Configuration
# Optional: Specify a custom absolute or relative path for property owner data persistence.
# Default: src/backend/data/propertyOwners.json
PROPERTY_OWNERS_DATA_PATH=

# Security & Session Configuration (For future JWT / Auth session tokens)
# AUTH_SECRET=your-random-32-character-secret-key-here

# Public App URL (For email verification and webhook callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
