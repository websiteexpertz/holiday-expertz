# HolidayExpertz Environment Configuration Template
# Copy this file to .env or .env.local for production/staging/local deployments

# ── Database Configuration ──
# Live MongoDB Atlas connection string with replica set & retry writes enabled
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/holiday-expertz?retryWrites=true&w=majority

# ── Server Runtime ──
NODE_ENV=production
PORT=3000

# ── Public Application URL ──
# Set this to the production domain (e.g. https://holidayexpertz.com or https://holiday-expertz.vercel.app)
NEXT_PUBLIC_APP_URL=https://holidayexpertz.com

# Separate frontend and backend deployments (optional)
# Set BACKEND_URL if frontend and backend run on different domains
BACKEND_URL=https://holidayexpertz.com

# ── Security & Authentication ──
# 32+ character secret key used to sign and verify Super Admin HMAC session tokens
ADMIN_SESSION_SECRET=holidayexpertz-superadmin-secret-2026-key

# ── Storage Configuration ──
# Optional: Specify a custom path for property owner data persistence (defaults to in-repo/bundled data)
# PROPERTY_OWNERS_DATA_PATH=
